# ── Python ───────────────────────────────────────
backend/venv/
backend/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/

# ── Node / React ─────────────────────────────────
frontend/node_modules/
frontend/build/
frontend/.pnp
frontend/.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environnement ────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# ── IDE / Éditeurs ───────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Docker ───────────────────────────────────────
.docker/

# ── Logs ─────────────────────────────────────────
*.log
logs/
